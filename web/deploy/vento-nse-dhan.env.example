DHAN_CLIENT_ID=replace-with-client-id
DHAN_PIN=replace-with-six-digit-pin
DHAN_TOTP_SECRET=replace-with-base32-totp-secret
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_URL=wss://api-feed.dhan.co
DHAN_EXCHANGE_SEGMENT=NSE_EQ
DHAN_INSTRUMENT=EQUITY
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
DHAN_TOKEN_CACHE_FILE=/var/lib/vento-nse/dhan/token_cache.json
DHAN_PREVIOUS_CLOSE_CACHE_FILE=/var/lib/vento-nse/dhan/previous_close_cache.json
DHAN_MINIMUM_COVERAGE=0.90
BACKTEST_PROXY_TOKEN=replace-with-64-random-hex-characters
LIVE_UNIVERSE_DIR=/var/lib/vento-nse/backtest/live-universe
LIVE_SIGNAL_DIR=/var/lib/vento-nse/backtest/live-signals
LIVE_SIGNAL_ENGINE_ENABLED=true
LIVE_MARKET_DATA_FILE=/var/lib/vento-nse/data/nse_symbols_rsi_volume.csv
NIFTY_EXPIRY_SCHEDULE_FILE=/etc/vento-nse-nifty-expiry-schedule.json
MARKET_ALIGNED_SECTOR_MAP_FILE=/etc/vento-nse-sector-map.csv
