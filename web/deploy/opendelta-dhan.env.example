DHAN_CLIENT_ID=replace-with-client-id
DHAN_PIN=replace-with-six-digit-pin
DHAN_TOTP_SECRET=replace-with-base32-totp-secret
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_URL=wss://api-feed.dhan.co
DHAN_EXCHANGE_SEGMENT=NSE_EQ
DHAN_INSTRUMENT=EQUITY
DHAN_INSTRUMENT_MASTER_URL=https://images.dhan.co/api-data/api-scrip-master.csv
DHAN_TOKEN_CACHE_FILE=/var/lib/opendelta/dhan/token_cache.json
DHAN_PREVIOUS_CLOSE_CACHE_FILE=/var/lib/opendelta/dhan/previous_close_cache.json
DHAN_MINIMUM_COVERAGE=0.90
BACKTEST_PROXY_TOKEN=replace-with-64-random-hex-characters
# Revocable ingress credential used only in TradingView alert JSON. Generate a
# different random value; never use exchange or broker credentials here.
TRADINGVIEW_WEBHOOK_KEY=replace-with-a-different-64-random-hex-characters
TRADINGVIEW_MAX_ALERT_AGE_SECONDS=900

# Public crypto/metal market data. No exchange API key is required for
# instrument discovery or historical completed candles.
CRYPTO_SIGNAL_POLL_SECONDS=60
CRYPTO_MARKET_DIR=/var/lib/opendelta/backtest/crypto-market
PLATFORM_DATA_DIR=/var/lib/opendelta/backtest/platform
# Canonical candle store. Keep the real password only in the server env file.
MARKET_DATA_DATABASE_URL=postgresql://opendelta:replace-me@opendelta-timescale:5432/opendelta
# V2 default: strict canonical Timescale reads. Use timescale-fallback only for
# an explicitly monitored rollback; never mix providers for the same stream.
PLATFORM_CANDLE_READ_MODE=timescale
SCREENER_CANDLE_BATCH_SIZE=50
MARKET_DATA_WORKER_PROVIDERS=DHAN,OKX
MARKET_DATA_WORKER_MAXIMUM_CHUNKS=100
OKX_PUBLIC_API_URL=https://www.okx.com
VALR_PUBLIC_API_URL=https://api.valr.com
# Optional AI Research Copilot. Leave unset to fail closed. Supply real keys
# only in the deployment secret file, never this tracked example.
# AI_PROVIDER=openai-compatible
# AI_PROVIDER_ENDPOINT=https://provider.example/v1/chat/completions
# AI_PROVIDER_API_KEY=replace-with-provider-secret
# AI_MODEL=operator-selected-model
# AI_PROVIDER_TIMEOUT_SECONDS=30
# AI_COPILOT_REQUESTS_PER_MINUTE=10
# Phase 11: supply the real master key through deployment secrets, never Git.
# EXCHANGE_CREDENTIAL_MASTER_KEY=
# EXCHANGE_CREDENTIAL_MASTER_KEY_VERSION=v1
# EXCHANGE_CREDENTIAL_PREVIOUS_KEYS={}
# OKX_PRIVATE_API_BASE_URL=https://www.okx.com
# VALR_PRIVATE_API_BASE_URL=https://api.valr.com
DEPLOYMENT_ENVIRONMENT=production
MONITORING_INTERVAL_SECONDS=30
# Optional HTTPS receiver for bounded, secret-free operational alert payloads.
MONITORING_WEBHOOK_URL=
# Server-to-server MCP clients omit Origin. Configure only known browser origins.
MCP_ALLOWED_ORIGINS=
# Optional provider endpoints; HTTPS or loopback only.
# DHAN_LIVE_ORDER_BASE_URL=https://api.dhan.co/v2
WALK_FORWARD_QUEUE_LIMIT=10
WALK_FORWARD_POLL_SECONDS=0.5
# Signal/Paper workers are created only by durable, approved V2 deployments.
# No environment variable may create or promote a strategy deployment.
LIVE_MARKET_DATA_FILE=/var/lib/opendelta/data/nse_symbols_rsi_volume.csv
NIFTY_EXPIRY_SCHEDULE_FILE=/etc/opendelta-nifty-expiry-schedule.json
MARKET_ALIGNED_SECTOR_MAP_FILE=/etc/opendelta-sector-map.csv
