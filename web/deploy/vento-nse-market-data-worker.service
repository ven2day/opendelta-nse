[Unit]
Description=OpenDelta canonical market-data backfill and repair worker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/install -d -o 10001 -g 10001 -m 0700 /var/lib/vento-nse/dhan
ExecStartPre=-/usr/bin/docker network create vento-nse-internal
ExecStartPre=-/usr/bin/docker rm -f vento-nse-market-data-worker
ExecStart=/usr/bin/docker run --rm --name vento-nse-market-data-worker \
  --network vento-nse-internal \
  --env-file /etc/vento-nse-dhan.env \
  --mount type=bind,source=/var/lib/vento-nse/dhan,target=/var/lib/vento-nse/dhan \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  --security-opt no-new-privileges:true \
  --cap-drop ALL \
  --pids-limit 128 \
  --memory 1g \
  vento-nse-backtest:current \
  python market_data_worker.py
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
