[Unit]
Description=Vento NSE dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vento-nse
Group=vento-nse
WorkingDirectory=/opt/vento-nse/web
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/vento-nse.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
