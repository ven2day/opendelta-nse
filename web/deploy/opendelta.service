[Unit]
Description=OpenDelta dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opendelta
Group=opendelta
WorkingDirectory=/opt/opendelta/web
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/opendelta.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
